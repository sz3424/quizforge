# QUIZFORGE backend configuration
# Copy to .env and fill in real values. Never commit .env.
# Placeholders below contain no real credentials.

APP_NAME=QuizForge
APP_ENV=development

# Server
HOST=127.0.0.1
PORT=8000

# Production note: the host platform must be able to override HOST/PORT.
# Render, Railway and Fly all inject their own PORT and expect the app to bind
# 0.0.0.0 (see start.sh), so do not hardcode these for a deploy.

# Storage
# PRODUCTION WARNING: SQLite plus a local uploads folder needs a PERSISTENT
# disk. On Render/Railway/Fly the default filesystem is ephemeral and is wiped
# on every deploy, restart and scale event, which deletes uploaded PDFs and
# every quiz. Either attach a persistent disk, or point DATABASE_URL at a real
# database and store uploads in object storage.
DATABASE_URL=sqlite:///./storage/quizforge.db
UPLOAD_DIR=./storage/uploads

# Upload limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=200

# Comma-separated list of allowed browser origins.
# This value is REQUIRED in production: without your site's origin here the
# browser blocks every API call and the UI reports "Couldn't reach the backend".
# Comma-separated and JSON-array formats are both accepted.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://your-site.netlify.app

# --- AI provider (optional) -------------------------------------------------
# Leave OPENAI_API_KEY empty to use the labelled offline generator.
# Keys are read only by the backend and are never returned to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1