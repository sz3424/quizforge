# QUIZFORGE backend configuration
# Copy to .env and fill in real values. Never commit .env.
# Placeholders below contain no real credentials.

APP_NAME=QuizForge
APP_ENV=development

# Server
HOST=127.0.0.1
PORT=8000

# Storage
DATABASE_URL=sqlite:///./storage/quizforge.db
UPLOAD_DIR=./storage/uploads

# Upload limits
MAX_FILE_SIZE_MB=25
MAX_PAGES=200

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (optional) -------------------------------------------------
# Leave OPENAI_API_KEY empty to use the labelled offline generator.
# Keys are read only by the backend and are never returned to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1